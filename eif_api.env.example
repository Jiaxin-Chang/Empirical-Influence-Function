# Copy to eif_api.env (same directory as this file) and fill in real paths.
# Loaded automatically by: python -m src.ttav_bundle_api
# Existing shell env vars are NOT overwritten.

# ── Model (required for Unlearn + Gold live attribution) ─────────────────────
# LoRA adapter directory (contains adapter_config.json) OR a full merged checkpoint
EIF_ADAPTER_PATH=/path/to/your/checkpoint-500

# Base CausalLM when EIF_ADAPTER_PATH is a LoRA adapter
EIF_BASE_MODEL_PATH=/path/to/Qwen3-8B

# Optional alias (used if EIF_ADAPTER_PATH is empty)
# EIF_MODEL_PATH=/path/to/merged-or-full-model

# ── Train data (required for Gold Stage2/3 bank + Stage3 scan) ────────────────
# Prefer chat JSONL with messages / attention_edges (same as intervention_experiment)
EIF_TRAIN_DATA=/path/to/smoke_train_data_chat.jsonl

# Fallback also read by unlearn / annotation tooling:
# ANNOTATION_TRAIN_DATA=/path/to/smoke_train_data_chat.jsonl

# ── Optional: pin an existing saliency train bank .pt ─────────────────────────
# If unset, the API loads/builds under .cache/saliency_train_bank (first call slow).
# EIF_SALIENCY_BANK_PATH=/path/to/bank_....pt

# ── Gold live attribution knobs ───────────────────────────────────────────────
# How many train answer tokens to scan in Stage3 (smaller = faster UI). Empty/0 = all.
EIF_GOLD_TOP_TARGETS=3
# Sources per train target in Stage3
EIF_GOLD_TOP_SOURCES=3
# Top saliency sources on the gold target / top trains retrieved
EIF_GOLD_TOP_SALIENCY=4
EIF_GOLD_TOP_TRAINS=10

# ── Server ────────────────────────────────────────────────────────────────────
# EIF_CACHE_ONLY=0
