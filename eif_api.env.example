# Single env for: python -m src.ttav_bundle_api  +  tools/annotation-viewer
# By default, values from this file overwrite stale shell env.
# Set EIF_ENV_NO_OVERRIDE=1 if you want shell env to win.
# Note: eif_api.env is gitignored — copy this file to eif_api.env on the machine.

# ── Model ─────────────────────────────────────────────────────────────────────
EIF_BASE_MODEL_PATH=/path/to/Qwen3-8B
EIF_ADAPTER_PATH_CE=/path/to/outputs/ce_only
EIF_ADAPTER_PATH_SALIENCY=/path/to/outputs/ce_saliency
# Legacy single adapter (only if family-specific paths empty):
# EIF_ADAPTER_PATH=/path/to/checkpoint-500

# ── Data ──────────────────────────────────────────────────────────────────────
# Compact train bank: input_ids + label/labels + attention_edges (NO ChatML re-encode).
# Same format as src/train AnnotatedSFTDataset / annotation-viewer.
EIF_TRAIN_DATA=/path/to/smoke_train_data.jsonl
# Continue-train line_hit eval: text prompt + response/label (not compact).
EIF_TEST_DATA=/path/to/gold_or_test.jsonl
# Optional: precomputed baseline line_hit JSONL for the SAME eval set as EIF_TEST_DATA.
# When set and file exists, continue-train skips GPU eval_before (avoids OOM).
# Each line needs task_id + line_hit_pre + line_hit_rec (your AI4Go score dump is fine).
# EIF_CONTINUE_EVAL_BEFORE_CACHE=/path/to/eval_before_results.jsonl

# annotation-viewer browse source (usually same compact file as EIF_TRAIN_DATA).
ANNOTATION_TRAIN_DATA=/path/to/smoke_train_data.jsonl
# Edits upsert here; also the only continue-train subset path.
# attention_edges in this file = user_add / user_bump / llm_auto only.
ANNOTATION_CONTINUE_TRAIN_DATA=/path/to/continue_annotated_subset.jsonl

# EIF_CONTINUE_OUTPUT_DIR=outputs/continue_trial
# Continue-train saliency weight (overrides adapter saliency_training_config).
# Start at 0.2 if λ=1.5 collapses generation on tiny annotated subsets.
# EIF_CONTINUE_SALIENCY_LAMBDA=0.2
# EIF_CONTINUE_MAX_STEPS=20

# ── Optional bank pins ────────────────────────────────────────────────────────
# EIF_SALIENCY_BANK_PATH_CE=.cache/saliency_train_bank/bank_....pt
# EIF_SALIENCY_BANK_PATH_SALIENCY=.cache/saliency_train_bank/bank_....pt
# Bank objective (defaults = train contrastive + neg_k=64):
# EIF_BANK_LOSS_MODE=ce_saliency
# EIF_BANK_SALIENCY_LOSS_TYPE=contrastive
# EIF_BANK_SALIENCY_LAMBDA=1.5
# EIF_BANK_SALIENCY_ALPHA=1.0
# EIF_BANK_SALIENCY_MARGIN_PLUS=2.0
# EIF_BANK_SALIENCY_NEG_SAMPLE_K=64
# EIF_BANK_SALIENCY_LAYER=-1

# ── LLM auto-annotate（仅 eif_api.env；ANNOTATE_BACKEND=api|vllm）──────────────
# ANNOTATE_BACKEND=api
# DASHSCOPE_API_KEY=sk-xxx
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# ANNOTATE_MODEL=qwen3.8-max
# ANNOTATE_MAX_TOKENS=4096
# Max directed edges the LLM may return per auto-annotate call (1..32).
# ANNOTATE_MAX_EDGES=8
# ANNOTATE_ENABLE_THINKING=1
#
# ANNOTATE_BACKEND=vllm
# OPENAI_BASE_URL=http://127.0.0.1:8000/v1
# OPENAI_API_KEY=dummy
# ANNOTATE_MODEL=qwen3-8b
# ANNOTATE_MAX_TOKENS=4096
# ANNOTATE_MAX_EDGES=8
